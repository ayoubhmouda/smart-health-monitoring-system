                <span>ID: <strong class="font-bold">#{{ alertPatientDetails?.id || 'غير محدد' }}</strong></span>
              </div>
              <div class="flex justify-between pt-1">
                <span>العمر: <strong class="font-bold">{{ alertPatientDetails?.age || 'غير محدد' }} سنة</strong></span>
                <span>الجنس: <strong class="font-bold">{{ alertPatientDetails?.element_type || 'مريض' }}</strong></span>
