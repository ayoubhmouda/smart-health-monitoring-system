// src/stores/alerts.js
import { defineStore } from 'pinia'
import { ref, computed } from 'vue'
import api from '../api'
import { usePatientStore } from './patient'

export const useAlertsStore = defineStore('alerts', () => {
  // In-Memory Cache Maps per patient to ensure 0ms instant loading on selection
  const allLatestReadings = ref({})      // { [patientId]: latestReadingsObject }
  const allChartReadings = ref({})        // { [patientId]: chartHistoryArray }
  const allMLInsights = ref({})          // { [patientId]: mlInsightObject }
  const activeInsights = ref({})           // { [patientId]: activeThresholdInsight }
  
  const isWsConnected = ref(false)
  const lastUpdatedTime = ref('')
  const justUpdated = ref(false)
  const showEmergencyBanner = ref(true)
  const countdown = ref(30)                // Fallback Countdown
  
  const patientAlertStates = ref({})       // Endangered patients map
  const wsSockets = ref({})                // WebSocket connection pool
  
  let chartFetchSeq = 0
  let countdownTimer = null

  const SENSOR_KEY_MAP = {
    'Heart Rate': 'heart_rate',
    'Oxygen Saturation': 'oxygen',
    'Activity Level': 'activity_level',
    'Body Temperature': 'temperature',
    'Blood Pressure Systolic': 'bp_sys',
    'Blood Pressure Diastolic': 'bp_dia',
    'Respiratory Rate': 'respiratory_rate',
    'Room Temperature': 'room_temperature',
  }

  const getReadingKey = (r) => {
    if (r?.id != null) return `id:${r.id}`
    const sensorName = r?.sensor_name || r?.sensor?.sensor_type?.name || 'unknown'
    return `k:${sensorName}:${r?.recorded_at}`
  }

  // Deduplicate and merge chart readings for a specific patient
  const mergeReadingsForPatient = (patientId, incoming) => {
    if (!Array.isArray(incoming) || incoming.length === 0) return
    const currentList = allChartReadings.value[patientId] || []
    const byKey = new Map(currentList.map(r => [getReadingKey(r), r]))
    incoming.forEach(r => {
      if (!r) return
      byKey.set(getReadingKey(r), r)
    })
    const merged = Array.from(byKey.values()).sort(
      (a, b) => new Date(a.recorded_at) - new Date(b.recorded_at)
    )
    
    allChartReadings.value = {
      ...allChartReadings.value,
      [patientId]: merged.length > 100 ? merged.slice(-100) : merged
    }
  }

  const applyToLatestReadings = (p_id, item) => {
    const key = SENSOR_KEY_MAP[item?.sensor_name]
    if (!key || !item) return
    if (!allLatestReadings.value[p_id]) {
      allLatestReadings.value[p_id] = {}
    }
    const existing = allLatestReadings.value[p_id][key]
    const incomingTime = item.recorded_at ? new Date(item.recorded_at).getTime() : null
    const existingTime = existing?.recorded_at ? new Date(existing.recorded_at).getTime() : -Infinity
    if (incomingTime == null || incomingTime >= existingTime) {
      allLatestReadings.value = {
        ...allLatestReadings.value,
        [p_id]: {
          ...allLatestReadings.value[p_id],
          [key]: { ...existing, ...item }
        }
      }
    }
  }

  // 🟢 جلب القراءات والتحقق من بقاء القواعد بالداتابيز لتطهير الإنذارات اليتيمة فوراً (4 REST Requests بالتوازي)
  const fetchData = async (patientId) => {
    if (!patientId) return
    try {
      const [readingsRes, insightRes, actionsRes, rulesRes] = await Promise.all([
        api.get('/api/sensor-readings/', {
          params: { sensor__monitored_element: patientId, monitored_element: patientId, ordering: '-recorded_at', limit: 30 }
        }),
        api.get('/api/insights/', {
          params: { monitored_element: patientId, ordering: '-detected_at', limit: 10 }
        }),
        api.get('/api/corrective-actions/'),
        api.get('/api/rules/', { params: { monitored_element: patientId } }) // 🟢 جلب القواعد النشطة حالياً للمريض
      ])
      
      const data = Array.isArray(readingsRes.data) ? readingsRes.data : (readingsRes.data.results || [])
      const actionsData = Array.isArray(actionsRes.data) ? actionsRes.data : (actionsRes.data.results || [])
      const rulesData = Array.isArray(rulesRes.data) ? rulesRes.data : (rulesRes.data.results || [])
      
      const currentPatientId = usePatientStore().currentPatient?.id
      if (Number(patientId) === Number(currentPatientId)) {
        latestReadings.value = {
          heart_rate: data.find(r => r.sensor_name === 'Heart Rate'),
          oxygen: data.find(r => r.sensor_name === 'Oxygen Saturation'),
          activity_level: data.find(r => r.sensor_name === 'Activity Level'),
          temperature: data.find(r => r.sensor_name === 'Body Temperature'),
          bp_sys: data.find(r => r.sensor_name === 'Blood Pressure Systolic'),
          bp_dia: data.find(r => r.sensor_name === 'Blood Pressure Diastolic'),
          respiratory_rate: data.find(r => r.sensor_name === 'Respiratory Rate'),
          room_temperature: data.find(r => r.sensor_name === 'Room Temperature'),
        }
      }

      const insightsList = Array.isArray(insightRes.data) ? insightRes.data : (insightRes.data.results || [])
      
      // 🟢 ربط كل استبصار بالإجراء التصحيحي الخاص به لاستخلاص مسمى القانون ووصف التوصية العلاجية
      const processedInsights = insightsList.map(item => {
        const action = actionsData.find(a => Number(a.insight) === Number(item.id))
        return {
          ...item,
          rule_name: action ? action.rule_name || action.rule?.name : null,
          action_template: action ? action.description || action.rule?.action_template : null
        }
      })

      if (Number(patientId) === Number(currentPatientId)) {
        latestInsight.value = processedInsights.find(i => i.source?.toLowerCase() === 'ml_model' || i.source?.toLowerCase() === 'ml') || null
      }
      
      // 🟢 استخدام وقت آخر قراءة حية مسجلة بالسيرفر كمرجع للوقت الحالي لتفادي أي فروقات وتأخير بساعة جهاز الطبيب
      const latestReading = data[0]
      const serverTime = latestReading ? new Date(latestReading.recorded_at).getTime() : new Date().getTime()

      // فحص وتصفية الإنذارات التاريخية القديمة بناءً على ساعة السيرفر الموحدة ومعيار بقاء القاعدة بالداتابيز
      const activeThreshold = processedInsights.find(i => {
        const isSevere = ['CRITICAL', 'HIGH'].includes(String(i.severity).toUpperCase())
        if (!isSevere) return false
        
        // 🟢 صمام الأمان المطور: إذا كان التنبيه من نوع قواعد الطبيب، نتأكد أن القاعدة لا تزال موجودة بالداتابيز ولم تُحذف
        const src = i.source?.toLowerCase()
        if (src === 'rules') {
          const ruleExists = rulesData.some(r => r.name === i.rule_name)
          if (!ruleExists) return false // إذا حُذفت القاعدة، نلغي الإنذار والخطأ فوراً!
        }

        const detectedTime = new Date(i.detected_at).getTime()
        const diff = serverTime - detectedTime
        
        // الإنذار يعتبر نشطاً فقط إذا كان قد حدث في آخر دقيقتين بالنسبة لساعة السيرفر الموحدة
        return diff >= 0 && diff < (2 * 60 * 1000)
      })

      if (activeThreshold) {
        activeInsights.value[patientId] = activeThreshold
      } else {
        activeInsights.value[patientId] = null
      }
      
      // فحص وتحديث حالة خطر المريض لتلوين السايدبار بالدرجة المناسبة
      if (activeThreshold) {
        const severity = String(activeThreshold.severity).toUpperCase()
        const src = activeThreshold.source?.toLowerCase()

        if (src === 'threshold') {
          const o2Obj = mappedReadings.oxygen
          const rrObj = mappedReadings.respiratory_rate
          const isO2Abnormal = o2Obj?.status && o2Obj.status !== 'Good'
          const isRrAbnormal = rrObj?.status && rrObj.status !== 'Good'
          
          if (isO2Abnormal || isRrAbnormal) {
            patientAlertStates.value[patientId] = severity
          } else {
            patientAlertStates.value[patientId] = null
            activeInsights.value[patientId] = null
          }
        } else {
          patientAlertStates.value[patientId] = severity
        }
      } else {
        patientAlertStates.value[patientId] = null
      }

      lastUpdatedTime.value = new Date().toLocaleTimeString('ar-LY', { hour: '2-digit', minute: '2-digit', second: '2-digit' })
    } catch (e) {
      console.error('Error fetching data in store:', e)
    }
  }

  // Fetch chart historical series via REST API (Initial load only)
  const fetchChartData = async (patientId) => {
    if (!patientId) return
    const now = new Date()
    const startDate = new Date(now.getTime() - 60 * 60 * 1000).toISOString()
    const requestId = ++chartFetchSeq
    try {
      const params = { sensor__monitored_element: patientId, ordering: '-recorded_at', start_date: startDate }
      const res = await api.get('/api/sensor-readings/', { params })
      const data = Array.isArray(res.data) ? res.data : (res.data.results || [])
      if (requestId !== chartFetchSeq) return
      mergeReadingsForPatient(patientId, data)
    } catch (e) {
      console.error(e)
    }
  }

  const updatePatientAlertState = (patientId) => {
    if (!patientId) return
    fetchData(patientId)
  }

  // Count active clinical alarms across all patients (Critical and High only)
  const activeAlertsCount = computed(() => {
    return Object.values(patientAlertStates.value).filter(v => v === 'CRITICAL' || v === 'HIGH').length
  })

  // Establishes the active severe warning globally across all patients
  const latestThresholdInsight = computed(() => {
    let bestInsight = null
    let bestWeight = 0

    for (const pId in activeInsights.value) {
      const insight = activeInsights.value[pId]
      if (!insight) continue

      // Verify that the patient is still flagged as active in the sidebar
      if (!patientAlertStates.value[pId]) continue

      const severity = String(insight.severity).toUpperCase()
      const weight = severity === 'CRITICAL' ? 2 : (severity === 'HIGH' ? 1 : 0)

      if (weight > bestWeight) {
        bestWeight = weight
        bestInsight = insight
      }
    }
    return bestInsight
  })

  // Run fallback countdown
  const startCountdown = (patientId) => {
    countdown.value = 30
    clearInterval(countdownTimer)
    countdownTimer = setInterval(() => {
      if (countdown.value > 0) {
        countdown.value--
      } else {
        fetchData(patientId)
        fetchChartData(patientId)
        countdown.value = 30
      }
    }, 1000)
  }

  // Setup multi-patient live background WS streams (Completely optimized)
  const setupAllWebSockets = (patientList) => {
    Object.values(wsSockets.value).forEach(socket => {
      socket.onclose = null; socket.onerror = null; socket.close()
    })
    wsSockets.value = {}
    clearInterval(countdownTimer)

    if (!Array.isArray(patientList) || patientList.length === 0) return

    const protocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:'
    const host = window.location.hostname || 'localhost'

    patientList.forEach(patient => {
      const p_id = patient.id
      const wsUrl = `${protocol}//${host}:8000/ws/notifications/${p_id}/`
      
      try {
        const currentSocket = new WebSocket(wsUrl)
        wsSockets.value[p_id] = currentSocket

        currentSocket.onopen = () => {
          isWsConnected.value = true
        }

        currentSocket.onmessage = (event) => {
          try {
            const payload = JSON.parse(event.data)
            console.log(`⚡ [WebSocket Patient #${p_id}] Payload received:`, payload)

            const currentId = currentPatientId.value

            if (payload?.type === 'sensor_update') {
              const newItems = Array.isArray(payload.readings) ? payload.readings : []
              
              // Real-time In-Memory updates per patient (No HTTP API requests needed)
              if (!allLatestReadings.value[p_id]) {
                allLatestReadings.value[p_id] = {}
              }
              newItems.forEach(item => {
                applyToLatestReadings(p_id, item)
              })

              mergeReadingsForPatient(p_id, newItems)

              if (Number(p_id) === Number(currentId)) {
                justUpdated.value = true; setTimeout(() => { justUpdated.value = false }, 1500)
                countdown.value = 30
              }

              // Update alert states in memory background
              const activeInsightObj = activeInsights.value[p_id]
              if (activeInsightObj) {
                const severity = String(activeInsightObj.severity).toUpperCase()
                const src = activeInsightObj.source?.toLowerCase()

                if (src === 'threshold') {
                  const o2Obj = allLatestReadings.value[p_id]?.oxygen
                  const rrObj = allLatestReadings.value[p_id]?.respiratory_rate
                  const isO2Abnormal = o2Obj?.status && o2Obj.status !== 'Good'
                  const isRrAbnormal = rrObj?.status && rrObj.status !== 'Good'
                  
                  if (isO2Abnormal || isRrAbnormal) {
                    patientAlertStates.value = { ...patientAlertStates.value, [p_id]: severity }
                  } else {
                    patientAlertStates.value = { ...patientAlertStates.value, [p_id]: null }
                    activeInsights.value = { ...activeInsights.value, [p_id]: null }
                  }
                } else {
                  patientAlertStates.value = { ...patientAlertStates.value, [p_id]: severity }
                }
              }

            } else if (payload?.type === 'insight_update') {
              // الـ WebSocket يبث تنبيهاً حياً يحدث "الآن" في الباك إند، لذا نثق بكونه حياً فورياً ونعرضه مباشرة
              if (payload.insight && ['CRITICAL', 'HIGH'].includes(String(payload.insight.severity).toUpperCase())) {
                activeInsights.value[p_id] = payload.insight
                patientAlertStates.value[p_id] = String(payload.insight.severity).toUpperCase()
              } else if (payload.insight && (payload.insight.source?.toLowerCase() === 'ml_model' || payload.insight.source?.toLowerCase() === 'ml')) {
                allMLInsights.value[p_id] = payload.insight
              }
            } else if (payload?.type === 'alert') {
              fetchData(p_id)
            }
          } catch (err) {
            console.error(err)
          }
        }

        currentSocket.onerror = () => {}
        currentSocket.onclose = () => {}

      } catch (err) {
        console.error(err)
      }
    })

    const currentId = currentPatientId.value
    if (currentId) {
      startCountdown(currentId)
    }
  }

  return {
    latestReadings, latestInsight, latestThresholdInsight, readings,
    isWsConnected, lastUpdatedTime, justUpdated, showEmergencyBanner, countdown,
    patientAlertStates, activeAlertsCount, fetchData, fetchChartData, setupAllWebSockets,
    updatePatientAlertState, startCountdown
  }
})
</file>

