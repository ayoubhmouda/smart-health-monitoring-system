<script setup>
import { computed, watch, watchEffect, onMounted } from 'vue'
import { useRoute, useRouter } from 'vue-router' // استيراد useRouter للانتقال السريع
import { useI18n } from 'vue-i18n'
import Sidebar from './components/sidebar.vue'          
import Navbar from './components/Navbar.vue'             
import { useDoctorStore } from './stores/doctor'
import { usePatientStore } from './stores/patient'        // تفعيل مخزن المريض
import { useAlertsStore } from './stores/alerts'          // تفعيل مخزن الإشعارات المطور

const route = useRoute()
const router = useRouter() // تفعيل راوتر التنقل السريع
const doctorStore = useDoctorStore()
const patientStore = usePatientStore()              
const alertsStore = useAlertsStore()                

const { locale } = useI18n()

const isAuthPage = computed(() => route.path === '/login' || route.path === '/register')

// مراقبة تغيير المريض بشكل مركزي دائم لا ينقطع عند التنقل بين الصفحات
watch(() => patientStore.currentPatient?.id, (newId) => {
  if (newId) {
    alertsStore.showEmergencyBanner = true // إعادة تفعيل البانر عند تغيير المريض
    alertsStore.fetchData(newId)
    alertsStore.fetchChartData(newId)
    alertsStore.startCountdown(newId) // تشغيل العداد التنازلي التكراري
  }
}, { immediate: true })

// استخلاص بيانات المريض المهدد بالخطر الحقيقي بناءً على إشارة الاستبصار النشطة حالياً لتأكيد العرض الصحيح للمريض المصاب
const alertPatientDetails = computed(() => {
  const alert = activeEmergencyAlert.value
  if (!alert) return null
  const alertPatient = alert.monitored_element
  const alertPatientId = alertPatient && typeof alertPatient === 'object' ? alertPatient.id : alertPatient
  return patientStore.patients?.find(p => Number(p.id) === Number(alertPatientId)) || null
})

// تصفية واكتشاف وجود إنذار طبي حرج نشط من شبكة الأمان لأي مريض من المرضى الموكلين للطبيب (تحديث عالمي دائم)
const activeEmergencyAlert = computed(() => {
  if (!alertsStore.latestThresholdInsight) return null
  
  // استخلاص آمن لمعرف المريض
  const alertPatient = alertsStore.latestThresholdInsight.monitored_element
  const alertPatientId = alertPatient && typeof alertPatient === 'object' ? alertPatient.id : alertPatient

  // صمام الأمان المطور: نتأكد أن هذا المريض المهدد بالخطر تحديداً ما زال في وضع خطر نشط في الـ Store
  if (!alertsStore.patientAlertStates[alertPatientId]) return null

  // التحقق من درجة الخطورة بحروف كبيرة وصغيرة (حصرها في الحالات الحرجة والعالية فقط)
  const severityFormatted = String(alertsStore.latestThresholdInsight.severity).toUpperCase()
  const isSevere = ['CRITICAL', 'HIGH'].includes(severityFormatted)
  if (!isSevere) return null

  return alertsStore.latestThresholdInsight
})

// مسمى درجة خطورة التنبيه النشط حالياً بالأحرف الكبيرة
const alertSeverity = computed(() => {
  if (!activeEmergencyAlert.value) return 'MEDIUM'
  return String(activeEmergencyAlert.value.severity).toUpperCase()
})

const severityLabel = computed(() => {
  switch (alertSeverity.value) {
    case 'CRITICAL': return 'حالة حرجة'
    case 'HIGH': return 'خطورة عالية'
    default: return 'خطورة متوسطة'
  }
})

// 🟢 تلوين وتنسيق الكارت عائماً بالبكسل ديناميكياً بناءً على مستوى الخطورة الثنائي للإنذار (Critical / High)
const alertClasses = computed(() => {
  switch (alertSeverity.value) {
    case 'CRITICAL':
      return {
        card: 'bg-rose-50/95 border-rose-300 border-r-rose-600 text-rose-950',
        badge: 'bg-rose-100 text-rose-800 border-rose-300',
        beaconPing: 'bg-rose-400',
        beaconDot: 'bg-rose-600',
        descText: 'text-rose-900',
        button: 'bg-rose-600 hover:bg-rose-700 shadow-rose-600/10'
      }
    default: // HIGH
      return {
        card: 'bg-amber-50/95 border-amber-300 border-r-amber-600 text-amber-950',
        badge: 'bg-amber-100 text-amber-800 border-amber-300',
        beaconPing: 'bg-amber-400',
        beaconDot: 'bg-amber-600',
        descText: 'text-amber-900',
        button: 'bg-amber-600 hover:bg-amber-700 shadow-amber-600/10'
      }
  }
})

// مسمى شارة نوع التنبيه ديناميكياً
const alertSourceLabel = computed(() => {
  const alert = activeEmergencyAlert.value
  if (!alert) return ''
  const src = alert.source?.toLowerCase()
  if (src === 'threshold') return 'إنذار شبكة الأمان'
  if (src === 'protocol' || src === 'global_protocol') return 'بروتوكول عام (المدير)'
  return 'قاعدة طبيب (خاصة)'
})

// دالة الانتقال السريع للمريض المهدد بالخطر ومعاينته بنقرة واحدة
const viewAffectedPatient = () => {
  const patient = alertPatientDetails.value
  if (patient) {
    patientStore.selectPatient(patient)
    alertsStore.showEmergencyBanner = true // المحافظة على فتح البانر عند الانتقال له
    router.push('/dashboard')
  }
}

const dismissEmergencyAlert = () => {
  alertsStore.showEmergencyBanner = false
}

// إعادة تفعيل البانر تلقائياً عند تغير كائن التنبؤ لضمان عدم إهمال تنبيه جديد
watch(() => alertsStore.latestThresholdInsight?.id, () => {
  alertsStore.showEmergencyBanner = true
})

// استعادة بروفايل المستخدم واسمه فور إعادة تحديث الصفحة (Refresh)
onMounted(async () => {
  if (localStorage.getItem('token')) {
    try {
      await doctorStore.fetchProfile()
    } catch (e) {
      console.error('فشل استعادة البروفايل عند التحديث:', e)
    }
  }
})

// يقلب اتجاه اللغة والصفحة ديناميكياً
watchEffect(() => {
  document.documentElement.lang = locale.value
  document.documentElement.dir = locale.value === 'ar' ? 'rtl' : 'ltr'
})
</script>

