# reasoning/predictors/threshold_predictor.py
from datetime import timedelta
from django.utils import timezone
from django.db.models import Q
from context.models import ContextHistory
from reasoning.models import Insight
from sensors.models import SensorType # 👈 استدعاء جدول قاعدة البيانات لتوحيد المصدر
from .base import BasePredictor


class ThresholdPredictor(BasePredictor):
    """
    شبكة أمان فسيولوجية موحدة: تفحص قراءات المريض الحالية مباشرة 
    وتقارنها بالعتبات الديناميكية المخزنة في قاعدة البيانات وتطلق استبصارات الطوارئ.
    (تم قصر الفحص هنا على المؤشرات المستقلة عن السياق الحركي: الأكسجين ومعدل التنفس)
    """

    def predict(self, context_history: ContextHistory) -> list[Insight]:
        context = context_history.context
        phys_data = context.physiological_data or {}

        # 1. منع تكرار الإنذار الفيسيولوجي خلال 5 دقائق لتلافي التشتيت
        five_min_ago = timezone.now() - timedelta(minutes=5)
        recent_alert = Insight.objects.filter(
            monitored_element=context_history.monitored_element,
            source=Insight.Source.THRESHOLD,
            detected_at__gte=five_min_ago
        ).exists()

        if recent_alert:
            return []

        # 2. تحديد الحساسات الحيوية المستقلة تماماً عن السياق والمخولة بتوليد كائن Insight حقيقي
        # وهي الحساسات المهددة للحياة بشكل مباشر دون تأثر بالنشاط (معدل التنفس، وتشبع الأكسجين)
        # (تم إزالة نبض القلب من هنا لأن تشخيصه يعتمد كلياً على السياق الحركي للمريض)
        field_to_db_name = {
            'oxygen_saturation': 'Oxygen Saturation',
            'respiratory_rate': 'Respiratory Rate',
        }

        # فحص الحساسات الحيوية المحددة فقط
        for field_name, db_name in field_to_db_name.items():
            value = phys_data.get(field_name)
            if value is not None:
                # 🟢 جلب العتبات الحقيقية المحدثة مباشرة من قاعدة البيانات لضمان تطابق تلوين الشاشة مع الباك إند
                sensor_type = SensorType.objects.filter(name=db_name).first()
                if not sensor_type:
                    continue

                min_val = sensor_type.normal_min
                max_val = sensor_type.normal_max

                # مطابقة الشروط ديناميكياً بقاعدة البيانات
                if (min_val is not None and value < min_val) or (max_val is not None and value > max_val):
                    
                    # تحديد درجة الخطورة: خطورة حرجة (Critical) للأكسجين دائماً أو عند تجاوز التنفس للحد بنسبة 10%
                    is_critical = field_name == 'oxygen_saturation' or (max_val is not None and value > (max_val * 1.1))
                    severity_level = Insight.Severity.CRITICAL if is_critical else Insight.Severity.HIGH
                    
                    # توليد كائن الاستبصار وحفظه في قاعدة البيانات للحدث المكتشف
                    return [Insight(
                        monitored_element=context_history.monitored_element,
                        context_history=context_history,
                        insight_type=Insight.InsightType.CURRENT_ABNORMALITY,
                        severity=severity_level,
                        confidence=0.99,
                        source=Insight.Source.THRESHOLD,
                    )]
        return []
