      <!-- واجهة العرض الرئيسية تتسع وتمرر بمفردها وبشكل مستقل تماماً وبانسيابية تامة -->
      <main class="flex-1 min-w-0 overflow-y-auto bg-[#F0F6F5] relative">
        
